{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "components/*": ["./components/*"],
      "styles/*": ["./styles/*"],
      "public/*": ["./public/*"],
      "hooks/*": ["./hooks/*"],
      "utils/*": ["./utils/*"],
      "api/*": ["./api/*"],
      "constants/*": ["./constants/*"],
      "context/*": ["./context/*"],
      "lib/*": ["./lib/*"],
      "providers/*": ["./providers/*"],
      "seed/*": ["./seed/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
